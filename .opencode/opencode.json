{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": {
      "*": "allow",
      "**/.env": "ask",
      "**/.env.example": "ask",
      "**/docker-compose.yml": "ask"
    },
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git ls-tree*": "allow",
      "mvn help:effective-pom*": "allow",
      "mvn clean test*": "allow",
      "mvn clean verify*": "allow",
      "mvn clean compile*": "allow",
      "mvn test*": "allow",
      "mvn compile*": "allow",
      "docker compose ps*": "allow",
      "docker compose logs*": "allow",
      "docker compose exec product-api-dev *": "allow",
      "docker compose up*": "ask",
      "docker compose down*": "ask",
      "docker compose restart*": "ask",
      "git commit*": "ask",
      "git push*": "ask",
      "docker rm*": "deny",
      "docker volume rm*": "deny",
      "docker system prune*": "deny",
      "docker image rm*": "deny",
      "rm -rf*": "deny",
      "git push --force*": "deny",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "*vcx-*": "deny",
      "*interesting_ellis*": "deny"
    }
  }
}
